# Create a Discord channel webhook and paste the complete URL here.
# Keep this secret. Do not commit .env.local to GitHub.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN

# Alert criteria
ALERT_MIN_PRICE=0.40
ALERT_MAX_PRICE=0.55
ALERT_CATEGORY=SPORTS
ALERT_TOP_TRADERS=10

# Polling and startup behavior
ALERT_POLL_SECONDS=30
# false = first run records recent trades without flooding Discord
# true = first run can alert on matching trades from the lookback window
ALERT_SEND_EXISTING_ON_START=false
ALERT_LOOKBACK_MINUTES=30

# Strategy Lab
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SECRET_OR_SERVICE_ROLE_KEY
ODDS_API_KEY=YOUR_ODDS_API_KEY
STRATEGY_POLL_SECONDS=120
STRATEGY_TOP_TRADERS=25
STRATEGY_MIN_PRICE=0.40
STRATEGY_MAX_PRICE=0.55
STRATEGY_MIN_CONSENSUS=2
STRATEGY_MIN_EDGE=0.04
STRATEGY_MIN_LIQUIDITY=20000
STRATEGY_MIN_MINUTES_TO_START=20
STRATEGY_STAKE=10
